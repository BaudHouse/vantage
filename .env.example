# Vantage — optional free API keys. Copy this file to ".env.local" and paste
# your keys. .env.local is gitignored; keys never leave your machine.
#
# Everything works WITHOUT these keys — they just unlock two extra map layers.

# Wildfires / thermal anomalies (NASA FIRMS). Free instant key:
#   https://firms.modaps.eosdis.nasa.gov/api/map_key/
VITE_FIRMS_KEY=

# Live vessel positions (AISStream.io). Free signup key:
#   https://aisstream.io/
VITE_AISSTREAM_KEY=
