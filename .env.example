# Vantage — optional free API keys. Copy to ".env.local" (gitignored) and paste
# your keys. Everything works WITHOUT these; they unlock extra layers.
# In a packaged Electron build, put keys in userData/keys.json instead (they are
# loaded at runtime and never bundled).

# Wildfires / global thermal (NASA FIRMS) — https://firms.modaps.eosdis.nasa.gov/api/map_key/
VITE_FIRMS_KEY=
# Live vessels / AIS (AISStream) — https://aisstream.io/
VITE_AISSTREAM_KEY=
# Global air quality / AQI (World Air Quality Index) — https://aqicn.org/data-platform/token/
VITE_WAQI_KEY=
# Global webcams (Windy) — https://api.windy.com/keys
VITE_WINDY_KEY=
